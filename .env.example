# Copy to .env and fill in. .env is gitignored and is NEVER read by the browser app —
# the app asks for the key once and stores it in localStorage.
# This file exists so the key has a documented home outside the source, and for a future
# backend proxy (see docs/DECISIONS.md D6).

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional, sent as headers so the app shows up on your OpenRouter dashboard
OPENROUTER_APP_TITLE=Document OCR
OPENROUTER_APP_URL=http://localhost:8000
